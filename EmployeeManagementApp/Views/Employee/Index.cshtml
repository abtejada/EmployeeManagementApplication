@model IEnumerable<EmployeeManagementApp.Models.EmployeeDirectoryViewModel>

@{
    ViewData["Title"] = "Employee Directory";
    bool hasSearched = ViewData["HasSearched"] as bool? ?? false;
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">Employee Separation Module</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-body">

                <form method="get" asp-action="Index" class="mb-4">
                    <div class="row">
                        <div class="col-md-5 col-sm-6 mb-2">
                            <label>Search Employee</label>
                            <div class="input-group">
                                <input type="text" name="searchTerm" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by name or employee ID..." required>
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-default" title="Search">
                                        <i class="fas fa-search"></i>
                                    </button>
                                    @if (hasSearched)
                                    {
                                        <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Search">
                                            <i class="fas fa-times"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="table-responsive">
                    <table id="employeeDirectoryTable" class="table table-bordered table-hover" style="width:100%">
                        <thead>
                            <tr>
                                <th>Employee ID</th>
                                <th>Full Name</th>
                                <th>Department</th>
                                <th>Position</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!hasSearched)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="fas fa-search fa-2x mb-2 d-block"></i>
                                        <strong>Please search for an employee to view details.</strong>
                                    </td>
                                </tr>
                            }
                            else if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="fas fa-info-circle fa-2x mb-2 d-block"></i>
                                        No employees found matching your search criteria.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.EmployeeId</td>
                                        <td>@item.FullName</td>
                                        <td>@item.Department</td>
                                        <td>@item.Position</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge badge-success">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Separated</span>
                                            }
                                        </td>
                                        <td>
                                            <button type="button"
                                                    class="btn btn-sm @(item.HasExistingSeparation ? "btn-warning" : "btn-outline-danger") open-separation-modal"
                                                    data-emp-id="@item.EmployeeCode"
                                                    data-emp-name="@item.FullName"
                                                    data-emp-pos="@item.Position"
                                                    data-emp-div="@item.Department"
                                                    data-sep-date="@item.SeparationDateFormatted"
                                                    data-sep-reason="@item.SeparationReason"
                                                    data-has-sep="@item.HasExistingSeparation.ToString().ToLower()">
                                                <i class="fas @(item.HasExistingSeparation ? "fa-edit" : "fa-user-slash") mr-1"></i>
                                                @(item.HasExistingSeparation ? "Edit Separation" : "Set Separation")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>

                        @*         
                         *@
                    </table>
                </div>

            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="separationModal" tabindex="-1" role="dialog" aria-labelledby="separationModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="separationForm">
                <div class="modal-header bg-danger text-white" id="separationModalHeader">
                    <h5 class="modal-title" id="separationModalTitle">Confirm Employee Separation</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="modalEmployeeCode" name="employeeCode" />

                    <div class="form-group mb-3">
                        <label><strong>Employee Name:</strong></label>
                        <input type="text" id="modalEmployeeName" class="form-control" readonly />
                    </div>
                    <div class="form-group mb-3">
                        <label><strong>Position:</strong></label>
                        <input type="text" id="modalEmployeePosition" class="form-control" readonly />
                    </div>
                    <div class="form-group mb-3">
                        <label><strong>Department / Division:</strong></label>
                        <input type="text" id="modalEmployeeDivision" class="form-control" readonly />
                    </div>

                    <hr />

                    <div class="form-group mb-3">
                        <label for="separationDate"><strong>Separation Date <span class="text-danger">*</span></strong></label>
                        <input type="date" id="separationDate" class="form-control" required />
                        <div class="invalid-feedback">Please select a separation date.</div>
                    </div>

                    <div class="form-group mb-3">
                        <label for="separationReason"><strong>Separation Reason / Remarks <span class="text-danger">*</span></strong></label>
                        <textarea id="separationReason" class="form-control" rows="3" placeholder="Enter reason for separation..." required></textarea>
                        <div class="invalid-feedback">Please provide a reason for separation.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary mr-auto" id="btnClearSeparationDate">
                        <i class="fas fa-times-circle"></i> Clear Date
                    </button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="btnSubmitSeparation">Proceed to Separate</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmActionModal" tabindex="-1" role="dialog" aria-labelledby="confirmActionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title font-weight-bold" id="confirmActionLabel">
                    <i class="fas fa-exclamation-triangle mr-2"></i>Confirm Action
                </h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body" id="confirmActionBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="btnConfirmActionSubmit">Yes, Proceed</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var hasSearched = @hasSearched.ToString().ToLower();
            var hasData = @((Model != null && Model.Any()).ToString().ToLower());

            if (hasSearched && hasData) {
                $('#employeeDirectoryTable').DataTable({
                    "responsive": true,
                    "autoWidth": false,
                    "paging": true,
                    "pageLength": 10,
                    "lengthChange": true,
                    "searching": true,
                    "info": true,
                    "order": [[1, "asc"]]
                });
            }

            $('#btnClearSeparationDate').on('click', function() {
                $('#separationDate').val('');
                $('#separationReason').val('');
            });

            $(document).on('click', '.open-separation-modal', function() {
                var empId = $(this).data('emp-id');
                var empName = $(this).data('emp-name');
                var empPos = $(this).data('emp-pos');
                var empDiv = $(this).data('emp-div');
                var sepDate = $(this).data('sep-date');
                var sepReason = $(this).data('sep-reason');
                var hasSep = $(this).data('has-sep') === true;

                $('#modalEmployeeCode').val(empId);
                $('#modalEmployeeName').val(empName);
                $('#modalEmployeePosition').val(empPos);
                $('#modalEmployeeDivision').val(empDiv);

                $('#separationDate').val(sepDate || '');
                $('#separationReason').val(sepReason || '');
                $('#separationForm').removeClass('was-validated');

                var $header = $('#separationModalHeader');
                var $submitBtn = $('#btnSubmitSeparation');

                if (hasSep) {
                    $header.removeClass('bg-danger text-white').addClass('bg-warning text-dark');
                    $('#separationModalTitle').html('<i class="fas fa-user-edit mr-2"></i>Edit Separation Details');
                    $submitBtn.removeClass('btn-danger').addClass('btn-warning').text('Update Separation Date');
                    $('#separationDate').removeAttr('required');
                } else {
                    $header.removeClass('bg-warning text-dark').addClass('bg-danger text-white');
                    $('#separationModalTitle').html('<i class="fas fa-user-slash mr-2"></i>Confirm Employee Separation');
                    $submitBtn.removeClass('btn-warning').addClass('btn-danger').text('Proceed to Separate');
                    $('#separationDate').attr('required', 'required');
                }

                $('#separationModal').modal('show');
            });

            $('#separationForm').on('submit', function(e) {
                e.preventDefault();
                var form = this;

                if (form.checkValidity() === false) {
                    e.stopPropagation();
                    $(form).addClass('was-validated');
                    return;
                }

                var empName = $('#modalEmployeeName').val();
                var sepDate = $('#separationDate').val();
                var hasSep = $('#btnSubmitSeparation').hasClass('btn-warning');

                var confirmMsg = '';
                if (!sepDate) {
                    confirmMsg = 'Are you sure you want to <strong>remove</strong> the separation record for <strong>' + empName + '</strong> and restore active status?';
                } else if (hasSep) {
                    confirmMsg = 'Are you sure you want to update the separation details for <strong>' + empName + '</strong> to effective <strong>' + sepDate + '</strong>?';
                } else {
                    confirmMsg = 'Are you sure you want to mark <strong>' + empName + '</strong> as separated effective <strong>' + sepDate + '</strong>?';
                }

                $('#confirmActionBody').html(confirmMsg);
                $('#confirmActionModal').modal('show');
            });

            $('#btnConfirmActionSubmit').on('click', function() {
                $('#confirmActionModal').modal('hide');

                var formData = {
                    employeeCode: $('#modalEmployeeCode').val(),
                    separationDate: $('#separationDate').val() || null,
                    separationReason: $('#separationReason').val()
                };

                var $submitBtn = $('#btnSubmitSeparation').prop('disabled', true);

                $.ajax({
                    url: '/Employee/UpdateSeparation',
                    type: 'POST',
                    data: formData,
                    success: function(response) {
                        $submitBtn.prop('disabled', false);
                        if (response.success) {
                            $('#separationModal').modal('hide');
                            location.reload();
                        } else {
                            alert('Error: ' + response.message);
                        }
                    },
                    error: function(xhr, status, error) {
                        $submitBtn.prop('disabled', false);
                        alert('AJAX Error: ' + (xhr.responseText || error));
                    }
                });
            });
        });
    </script>
}