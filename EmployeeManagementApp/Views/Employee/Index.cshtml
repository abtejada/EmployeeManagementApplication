@model IEnumerable<EmployeeManagementApp.Models.EmployeeDirectoryViewModel>

@{
    ViewData["Title"] = "Employee Directory";
    bool hasSearched = ViewData["HasSearched"] as bool? ?? false;
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">Employee Update Module</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-body">

                <form method="get" asp-action="Index" class="mb-4">
                    <div class="row">
                        <div class="col-md-5 col-sm-6 mb-2">
                            <label>Search Employee</label>
                            <div class="input-group">
                                <input type="text" name="searchTerm" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by name or employee ID..." required>
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-default" title="Search">
                                        <i class="fas fa-search"></i>
                                    </button>
                                    @if (hasSearched)
                                    {
                                        <a asp-action="Index" class="btn btn-outline-secondary" title="Clear Search">
                                            <i class="fas fa-times"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="table-responsive">
                    <table id="employeeDirectoryTable" class="table table-bordered table-hover" style="width:100%">
                        <thead class="bg-light text-dark text-center font-weight-bold">
                            <tr>
                                <th class="p-2 border">Employee ID</th>
                                <th class="p-2 border">Prefix</th>
                                <th class="p-2 border">Full Name</th>
                                <th class="p-2 border">Extension Name</th>
                                <th class="p-2 border">Suffix</th>
                                <th class="p-2 border">Division</th>
                                <th class="p-2 border">Position</th>
                                <th class="p-2 border">Status</th>
                                <th class="p-2 border" style="width: 220px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!hasSearched)
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-5">
                                        <div class="my-3">
                                            <i class="fas fa-search fa-3x text-primary mb-3"></i>
                                            <h5><strong>Employee Search Required</strong></h5>
                                            <p class="text-muted mb-0">Please enter an employee name or ID in the search bar above to load directory records.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else if (Model == null || !Model.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-5">
                                        <div class="my-3">
                                            <i class="fas fa-user-slash fa-3x text-warning mb-3"></i>
                                            <h5><strong>No Records Found</strong></h5>
                                            <p class="text-muted mb-0">No matching employee profiles were found for your search term.</p>
                                        </div>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.EmployeeId</td>
                                        <td>@item.Prefix</td>
                                        <td>@item.FullName</td>
                                        <td>@item.ExtensionName</td>
                                        <td>@item.Suffix</td>
                                        <td>@item.Department</td>
                                        <td>@item.Position</td>
                                        <td class="text-center">
                                            @if (item.IsActive)
                                            {
                                                <span class="badge badge-success px-2 py-1">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger px-2 py-1">Separated</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <!-- 1. Edit Profile Button -->
                                            <button type="button"
                                                    class="btn btn-sm btn-primary open-profile-modal mb-1"
                                                    data-emp-code="@item.EmployeeCode"
                                                    data-prefix="@item.Prefix"
                                                    data-given-name="@item.GivenName"
                                                    data-middle-name="@item.MiddleName"
                                                    data-surname="@item.Surname"
                                                    data-ext-name="@item.ExtensionName"
                                                    data-suffix="@item.Suffix">
                                                <i class="fas fa-id-card mr-1"></i> Edit Profile
                                            </button>

                                            <!-- 2. Manage/Set Separation Button -->
                                            <button type="button"
                                                    class="btn btn-sm @(item.HasExistingSeparation ? "btn-warning" : "btn-outline-danger") open-separation-modal mb-1"
                                                    data-emp-code="@item.EmployeeCode"
                                                    data-emp-name="@item.FullName"
                                                    data-sep-date="@item.SeparationDateFormatted"
                                                    data-sep-reason="@item.SeparationReason"
                                                    data-sep-remarks="@item.SeparationRemarks"
                                                    data-has-sep="@item.HasExistingSeparation.ToString().ToLower()">
                                                <i class="fas @(item.HasExistingSeparation ? "fa-calendar-alt" : "fa-user-slash") mr-1"></i>
                                                @(item.HasExistingSeparation ? "Manage Sep" : "Set Sep")
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</section>
<!-- Edit Profile Modal -->
<div class="modal fade" id="profileModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="profileForm">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="fas fa-id-card mr-2"></i>Edit Employee Profile</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="profileEmployeeCode" name="EmployeeCode" />

                    <!-- Prefix Row -->
                    <div class="form-group">
                        <label>Prefix</label>
                        <input type="text" id="profilePrefix" name="Prefix" class="form-control" placeholder="Mr./Ms." />
                    </div>

                    <!-- Given Name Row -->
                    <div class="form-group">
                        <label>Given Name <span class="text-danger">*</span></label>
                        <input type="text" id="profileGivenName" name="GivenName" class="form-control" required />
                    </div>

                    <!-- Middle Name Row -->
                    <div class="form-group">
                        <label>Middle Name</label>
                        <input type="text" id="profileMiddleName" name="MiddleName" class="form-control" />
                    </div>

                    <!-- Surname Row -->
                    <div class="form-group">
                        <label>Surname <span class="text-danger">*</span></label>
                        <input type="text" id="profileSurname" name="Surname" class="form-control" required />
                    </div>

                    <!-- Extension Name Row -->
                    <div class="form-group">
                        <label>Extension Name</label>
                        <input type="text" id="profileExtensionName" name="ExtensionName" class="form-control" placeholder="Jr, Sr ..." />
                    </div>

                    <!-- Suffix Row -->
                    <div class="form-group">
                        <label>Suffix</label>
                        <input type="text" id="profileSuffix" name="Suffix" class="form-control" placeholder="III, IV ..." />
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSubmitProfile">Save Profile Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Separation Modal -->
<div class="modal fade" id="separationModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="separationForm">
                <div class="modal-header bg-danger text-white" id="separationModalHeader">
                    <h5 class="modal-title" id="separationModalTitle"><i class="fas fa-user-slash mr-2"></i>Manage Separation</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="separationEmployeeCode" name="EmployeeCode" />

                    <div class="form-group mb-3">
                        <label><strong>Employee Name:</strong></label>
                        <input type="text" id="separationEmployeeName" class="form-control bg-light" readonly />
                    </div>

                    <div class="form-group mb-3">
                        <label for="separationDate"><strong>Separation Date <span class="text-danger">*</span></strong></label>
                        <input type="date" id="separationDate" name="SeparationDate" class="form-control" required />
                    </div>

                    <!-- Predefined Reason Dropdown (Required, No default placeholder value) -->
                    <div class="form-group mb-3">
                        <label for="separationReason"><strong>Separation Reason <span class="text-danger">*</span></strong></label>
                        <select id="separationReason" name="SeparationReason" class="form-control" required>
                            <option value="">-- Select Reason --</option>
                            <option value="Resigned">Resigned</option>
                            <option value="Terminated">Terminated</option>
                            <option value="Retired">Retired</option>
                            <option value="End of Contract">End of Contract</option>
                            <option value="Clear Separation Date">Clear Separation Date</option>
                        </select>
                    </div>

                    <!-- Separate Remarks Textarea (Required) -->
                    <div class="form-group mb-3">
                        <label for="separationRemarks"><strong>Remarks <span class="text-danger">*</span></strong></label>
                        <textarea id="separationRemarks" name="SeparationRemarks" class="form-control" rows="3" placeholder="Enter mandatory separation remarks..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary mr-auto" id="btnClearSeparation" title="Clearing separation restores active status">
                        <i class="fas fa-times-circle"></i> Clear Separation (Restore Active)
                    </button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger" id="btnSubmitSeparation">Save Separation</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            var hasSearched = @hasSearched.ToString().ToLower();
            var hasData = @((Model != null && Model.Any()).ToString().ToLower());

            // Initialize DataTable safely
            if (hasSearched && hasData) {
                $('#employeeDirectoryTable').DataTable({
                    "responsive": true,
                    "autoWidth": false,
                    "paging": true,
                    "pageLength": 10,
                    "lengthChange": true,
                    "searching": true,
                    "info": true,
                    "order": [[2, "asc"]]
                });
            }

            // ==========================================
            // 1. PROFILE EDIT MODAL HANDLERS
            // ==========================================
            $(document).on('click', '.open-profile-modal', function() {
                var $btn = $(this);
                $('#profileEmployeeCode').val($btn.data('emp-code'));
                $('#profilePrefix').val($btn.data('prefix'));
                $('#profileGivenName').val($btn.data('given-name'));
                $('#profileMiddleName').val($btn.data('middle-name'));
                $('#profileSurname').val($btn.data('surname'));
                $('#profileExtensionName').val($btn.data('ext-name'));
                $('#profileSuffix').val($btn.data('suffix'));

                $('#profileForm').removeClass('was-validated');
                $('#profileModal').modal('show');
            });

            // Handle Profile Form AJAX Submission
            $('#profileForm').on('submit', function(e) {
                e.preventDefault();
                var form = this;

                if (form.checkValidity() === false) {
                    e.stopPropagation();
                    $(form).addClass('was-validated');
                    return;
                }

                Swal.fire({
                    title: 'Save Profile Changes?',
                    text: "Are you sure you want to update this employee's profile details?",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#007bff',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, save changes!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#profileModal').modal('hide');
                        var formData = $(form).serialize();
                        var $submitBtn = $('#btnSubmitProfile').prop('disabled', true);

                        $.ajax({
                            url: '/Employee/UpdateProfile',
                            type: 'POST',
                            data: formData,
                            success: function(response) {
                                $submitBtn.prop('disabled', false);
                                if (response.success) {
                                    Swal.fire({
                                        title: 'Success!',
                                        text: response.message || 'Profile updated successfully.',
                                        icon: 'success',
                                        timer: 1500,
                                        showConfirmButton: false
                                    }).then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Error!', response.message, 'error');
                                }
                            },
                            error: function(xhr, status, error) {
                                $submitBtn.prop('disabled', false);
                                Swal.fire('AJAX Error!', (xhr.responseText || error), 'error');
                            }
                        });
                    }
                });
            });

            // ==========================================
            // 2. SEPARATION MODAL HANDLERS
            // ==========================================
            $('#btnClearSeparation').on('click', function() {
                // Clear the date field and remove its required attribute (since clearing means null date)
                $('#separationDate').val('').removeAttr('required');

                // Keep Reason and Remarks mandatory so user must provide an explanation for clearing/restoring
                $('#separationReason').attr('required', 'required');
                $('#separationRemarks').attr('required', 'required');

                var empName = $('#separationEmployeeName').val();

                Swal.fire({
                    title: 'Restore Active Status?',
                    html: 'Are you sure you want to <strong>remove the separation record</strong> for <strong>' + empName + '</strong> and restore active status?<br/><br/><small class="text-muted">Please ensure you have filled out the Reason and Remarks fields to record why this is being cleared.</small>',
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: '#28a745',
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, proceed to restore!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#separationForm').submit();
                    }
                });
            });

            $(document).on('click', '.open-separation-modal', function() {
                var $btn = $(this);
                var empCode = $btn.data('emp-code');
                var empName = $btn.data('emp-name');
                var sepDate = $btn.data('sep-date');
                var sepReason = $btn.data('sep-reason');
                var sepRemarks = $btn.data('sep-remarks');
                var hasSep = $btn.data('has-sep') === true;

                $('#separationEmployeeCode').val(empCode);
                $('#separationEmployeeName').val(empName);

                // Make all fields required when opening modal normally
                $('#separationDate').val(sepDate || '').attr('required', 'required');
                $('#separationReason').val(sepReason || '').attr('required', 'required');
                $('#separationRemarks').val(sepRemarks || '').attr('required', 'required');

                $('#separationForm').removeClass('was-validated');

                var $header = $('#separationModalHeader');
                var $submitBtn = $('#btnSubmitSeparation');

                if (hasSep) {
                    $header.removeClass('bg-danger text-white').addClass('bg-warning text-dark');
                    $('#separationModalTitle').html('<i class="fas fa-calendar-alt mr-2"></i>Manage Separation Details');
                    $submitBtn.removeClass('btn-danger').addClass('btn-warning').text('Update Separation');
                } else {
                    $header.removeClass('bg-warning text-dark').addClass('bg-danger text-white');
                    $('#separationModalTitle').html('<i class="fas fa-user-slash mr-2"></i>Set Employee Separation');
                    $submitBtn.removeClass('btn-warning').addClass('btn-danger').text('Proceed to Separate');
                }

                $('#separationModal').modal('show');
            });

            // Handle Separation Form AJAX Submission with SweetAlert2
            $('#separationForm').on('submit', function(e) {
                e.preventDefault();
                var form = this;

                if (form.checkValidity() === false) {
                    e.stopPropagation();
                    $(form).addClass('was-validated');
                    return;
                }

                var empName = $('#separationEmployeeName').val();
                var sepDate = $('#separationDate').val();
                var hasSep = $('#btnSubmitSeparation').hasClass('btn-warning');

                var confirmTitle = !sepDate ? 'Confirm Active Status Restoration?' : (hasSep ? 'Update Separation Details?' : 'Confirm Employee Separation?');
                var confirmText = '';
                var confirmButtonColor = !sepDate ? '#28a745' : (hasSep ? '#ffc107' : '#dc3545');

                if (!sepDate) {
                    confirmText = 'Are you sure you want to <strong>remove the separation record</strong> for <strong>' + empName + '</strong> and <strong>restore active status</strong>?';
                } else if (hasSep) {
                    confirmText = 'Are you sure you want to update separation details for <strong>' + empName + '</strong> effective <strong>' + sepDate + '</strong>?';
                } else {
                    confirmText = 'Are you sure you want to mark <strong>' + empName + '</strong> as separated effective <strong>' + sepDate + '</strong>?';
                }

                Swal.fire({
                    title: confirmTitle,
                    html: confirmText,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: confirmButtonColor,
                    cancelButtonColor: '#6c757d',
                    confirmButtonText: 'Yes, proceed!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $('#separationModal').modal('hide');

                        var formData = {
                            employeeCode: $('#separationEmployeeCode').val(),
                            separationDate: $('#separationDate').val() || null,
                            separationReason: $('#separationReason').val(),
                            separationRemarks: $('#separationRemarks').val()
                        };

                        var $submitBtn = $('#btnSubmitSeparation').prop('disabled', true);

                        $.ajax({
                            url: '/Employee/UpdateSeparation',
                            type: 'POST',
                            data: formData,
                            success: function(response) {
                                $submitBtn.prop('disabled', false);
                                if (response.success) {
                                    Swal.fire({
                                        title: 'Success!',
                                        text: response.message || 'Separation record updated successfully.',
                                        icon: 'success',
                                        timer: 1500,
                                        showConfirmButton: false
                                    }).then(() => {
                                        location.reload();
                                    });
                                } else {
                                    Swal.fire('Error!', response.message, 'error');
                                }
                            },
                            error: function(xhr, status, error) {
                                $submitBtn.prop('disabled', false);
                                Swal.fire('AJAX Error!', (xhr.responseText || error), 'error');
                            }
                        });
                    }
                });
            });
        });
    </script>
}