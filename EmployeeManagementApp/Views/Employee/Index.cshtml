@model IEnumerable<EmployeeManagementApp.Controllers.EmployeeDirectoryViewModel>

@{
    ViewData["Title"] = "Employee Directory";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">Employee Directory</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title">Employee Records</h3>
            </div>
            <div class="card-body">
                <!-- Search and Filter Form Header -->
                <form method="get" class="mb-4">
                    <div class="row">
                        <div class="col-md-5 col-sm-6 mb-2">
                            <label>Search Employee</label>
                            <div class="input-group">
                                <input type="text" name="searchTerm" class="form-control" placeholder="Search by name, ID, or department...">
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-default">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 col-sm-6 mb-2">
                            <label>Filter by Status</label>
                            <select name="statusFilter" class="form-control">
                                <option value="All">All Statuses</option>
                                <option value="Active">Active Only</option>
                                <option value="Separated">Separated Only</option>
                            </select>
                        </div>
                        <div class="col-md-4 col-sm-12 mb-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary mr-2">
                                <i class="fas fa-filter"></i> Apply Filters
                            </button>
                            <a asp-controller="Employee" asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-undo"></i> Reset
                            </a>
                        </div>
                    </div>
                </form>

                <!-- Data Table -->
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>No.</th> <!-- Added missing header for the sequential ID -->
                            <th>HRIS ID</th>
                            <th>Full Name</th>
                            <th>Department</th>
                            <th>Position</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.EmployeeCode</td>
                                    <td>@item.FullName</td>
                                    <td>@item.Department</td>
                                    <td>@item.Position</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Separated</span>
                                        }
                                    </td>
                                    <td>
                                        <!-- Button that triggers the Separation Modal -->
                                        <button type="button" class="btn btn-sm btn-outline-primary open-separation-modal"
                                                data-emp-id="@item.EmployeeCode"
                                                data-emp-name="@item.FullName">
                                            <i class="fas fa-user-slash"></i> Separation
                                        </button>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="fas fa-search fa-2x mb-2 d-block"></i>
                                    No employee records found matching your search criteria.
                                </td>
                            </tr>

                        }
                    </tbody>
                </table>
                <!-- Pagination Controls (Max 10 visible pages) -->
                <div class="card-footer clearfix">
                    <ul class="pagination pagination-sm m-0 float-right">
                        @{
                            int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
                            int totalPages = (int)(ViewData["TotalPages"] ?? 1);
                            string? currentFilter = ViewData["CurrentFilter"] as string;
                            string? currentStatus = ViewData["CurrentStatus"] as string;

                            // Define how many page buttons to show at once
                            int maxPagesToShow = 10;
                            int startPage = Math.Max(1, currentPage - (maxPagesToShow / 2));
                            int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

                            // Adjust if we are near the end of the total pages
                            if ((endPage - startPage + 1) < maxPagesToShow)
                            {
                                startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                            }
                        }

                        <!-- First Page Button (optional quick jump) -->
                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="1"
                                   asp-route-searchTerm="@currentFilter"
                                   asp-route-statusFilter="@currentStatus">&laquo;&laquo;</a>
                            </li>
                        }

                        <!-- Previous Button -->
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(currentPage - 1)"
                               asp-route-searchTerm="@currentFilter"
                               asp-route-statusFilter="@currentStatus">&laquo; Previous</a>
                        </li>

                        <!-- Bounded Page Number Links (Max 10) -->
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@i"
                                   asp-route-searchTerm="@currentFilter"
                                   asp-route-statusFilter="@currentStatus">@i</a>
                            </li>
                        }

                        <!-- Next Button -->
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pageNumber="@(currentPage + 1)"
                               asp-route-searchTerm="@currentFilter"
                               asp-route-statusFilter="@currentStatus">Next &raquo;</a>
                        </li>

                        <!-- Last Page Button (optional quick jump) -->
                        @if (endPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pageNumber="@totalPages"
                                   asp-route-searchTerm="@currentFilter"
                                   asp-route-statusFilter="@currentStatus">&raquo;&raquo;</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

        </div>
    </div>
</section>
<!-- Separation Modal -->
<div class="modal fade" id="separationModal" tabindex="-1" role="dialog" aria-labelledby="separationModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="separationForm">
                @Html.AntiForgeryToken()
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title" id="separationModalLabel">Update Employee Separation</h5>
                    <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <!-- Hidden field to store Employee Code/ID -->
                    <input type="hidden" id="modalEmployeeCode" name="EmployeeCode" />

                    <div class="form-group mb-3">
                        <label>Employee Name:</label>
                        <input type="text" id="modalEmployeeName" class="form-control" readonly />
                    </div>

                    <div class="form-group mb-3">
                        <label for="separationDate">Separation Date:</label>
                        <input type="date" id="separationDate" name="SeparationDate" class="form-control" />
                    </div>

                    <div class="form-group mb-3">
                        <label for="separationReason">Reason / Remarks:</label>
                        <textarea id="separationReason" name="SeparationReason" class="form-control" rows="3" placeholder="Enter reason for separation..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Save Separation Record</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Open modal and populate data when button is clicked
            $('.open-separation-modal').click(function () {
                var empCode = $(this).data('emp-id');
                var empName = $(this).data('emp-name');

                $('#modalEmployeeCode').val(empCode);
                $('#modalEmployeeName').val(empName);
                $('#separationDate').val('');
                $('#separationReason').val('');

                $('#separationModal').modal('show');
            });

            // Handle AJAX form submission for updating separation
            $('#separationForm').submit(function (e) {
                e.preventDefault();

                var formData = {
                    employeeCode: $('#modalEmployeeCode').val(),
                    separationDate: $('#separationDate').val(),
                    separationReason: $('#separationReason').val()
                };

                $.ajax({
                    url: '/Employee/UpdateSeparation',
                    type: 'POST',
                    data: formData,
                   success: function (response) {
                        if (response.success) {
                            $('#separationModal').modal('hide');
                            location.reload(); // Refreshes page to render the updated badge
                        } else {
                            alert(response.message || "Failed to update separation status.");
                        }
                    },
                    error: function () {
                        alert('An error occurred while saving the separation record.');
                    }
                });
            });
        });
    </script>
}