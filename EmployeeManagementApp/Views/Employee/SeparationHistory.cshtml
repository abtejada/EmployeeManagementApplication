@model IEnumerable<EmployeeManagementApp.Models.EmployeeSeparationHistoryViewModel>

@{
    ViewData["Title"] = "Separation History";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">Separation History Log</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            <div class="card-body">

                <!-- Data Table handled entirely by DataTables.net (Search, Pagination, Sorting) -->
                <div class="table-responsive">
                    <table id="separationHistoryTable" class="table table-bordered table-striped" style="width:100%">
                        <thead>
                            <tr>
                                <th>Log ID</th>
                                <th>Employee ID</th>
                                <th>Full Name</th>
                                <th>Division</th>
                                <th>Position</th>
                                <th>Separation Date</th>
                                <th>Reason / Remarks</th>
                                <th>Separated By</th>
                                <th>Created At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.SeparationLogId</td>
                                        <td>@item.EmployeeId</td>
                                        <td>@item.FullName</td>
                                        <td>@item.Department</td>
                                        <td>@item.Position</td>
                                        <td>@(item.SeparationDate.HasValue ? item.SeparationDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                                        <td>@(string.IsNullOrEmpty(item.SeparationReason) ? "—" : item.SeparationReason)</td>
                                        <td>@item.SeparatedBy</td>
                                        <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-4">
                                        <i class="fas fa-info-circle fa-2x mb-2 d-block"></i>
                                        No separation history records found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <!-- DataTables JS Initialization -->
    <script>
        $(document).ready(function() {
            $('#separationHistoryTable').DataTable({
                "responsive": true,
                "autoWidth": false,
                "paging": true,       // Native DataTables pagination
                "pageLength": 10,     // Default rows per page
                "lengthChange": true, // Allow user to change records per page
                "searching": true,    // Enables the built-in DataTables search box automatically
                "info": true,         // Shows entry count info
                "order": [[0, "desc"]] // Default sort descending by Log ID (newest first)
            });
        });
    </script>
}