@model IEnumerable<EmployeeManagementApp.Models.EmployeeSeparationHistoryViewModel>

@{
    ViewData["Title"] = "Separation History";
}

<div class="content-header">
    <div class="container-fluid">
        <h1 class="m-0">Separation History Log</h1>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card card-primary card-outline">
            @* <div class="card-header">
                <h3 class="card-title">Offboarded Employee Records</h3>
            </div> *@
            <div class="card-body">
                <!-- Search Filter Form -->
                <form method="get" asp-action="SeparationHistory" class="mb-4">
                    <div class="row">
                        <div class="col-md-5 col-sm-6 mb-2">
                            <div class="input-group">
                                <input type="text" name="searchTerm" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search by name, ID, or HRIS...">
                                <div class="input-group-append">
                                    <button type="submit" class="btn btn-default">
                                        <i class="fas fa-search"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <!-- Data Table -->
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Log ID</th> <!-- Added SeparationLogId Column -->
                                <th>Employee ID</th>
                                @* <th>HRIS ID</th> *@
                                <th>Full Name</th>
                                <th>Division</th>
                                <th>Position</th>
                                <th>Separation Date</th>
                                <th>Reason / Remarks</th>
                                <th>Created By</th>
                                <th>Created At</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.SeparationLogId</td>
                                        <td>@item.EmployeeId</td>
                                        @* <td>@item.EmployeeCode</td> *@
                                        <td>@item.FullName</td>
                                        <td>@item.Department</td>
                                        <td>@item.Position</td>
                                        <td>@(item.SeparationDate.HasValue ? item.SeparationDate.Value.ToString("yyyy-MM-dd") : "—")</td>
                                        <td>@(string.IsNullOrEmpty(item.SeparationReason) ? "—" : item.SeparationReason)</td>
                                        <td>@item.SeparatedBy</td>
                                        <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center text-muted py-4">
                                        <i class="fas fa-info-circle fa-2x mb-2 d-block"></i>
                                        No separation history records found.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination Controls -->
                <div class="card-footer clearfix">
                    <ul class="pagination pagination-sm m-0 float-right">
                        @{
                            int currentPage = (int)(ViewData["CurrentPage"] ?? 1);
                            int totalPages = (int)(ViewData["TotalPages"] ?? 1);
                            string? currentFilter = ViewData["CurrentFilter"] as string;

                            int maxPagesToShow = 10;
                            int startPage = Math.Max(1, currentPage - (maxPagesToShow / 2));
                            int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

                            if ((endPage - startPage + 1) < maxPagesToShow)
                            {
                                startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                            }
                        }

                        <!-- First Page -->
                        @if (startPage > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="SeparationHistory" asp-route-pageNumber="1" asp-route-searchTerm="@currentFilter">&laquo;&laquo;</a>
                            </li>
                        }

                        <!-- Previous -->
                        <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                            <a class="page-link" asp-action="SeparationHistory" asp-route-pageNumber="@(currentPage - 1)" asp-route-searchTerm="@currentFilter">&laquo; Previous</a>
                        </li>

                        <!-- Page Numbers -->
                        @for (int i = startPage; i <= endPage; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-action="SeparationHistory" asp-route-pageNumber="@i" asp-route-searchTerm="@currentFilter">@i</a>
                            </li>
                        }

                        <!-- Next -->
                        <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                            <a class="page-link" asp-action="SeparationHistory" asp-route-pageNumber="@(currentPage + 1)" asp-route-searchTerm="@currentFilter">Next &raquo;</a>
                        </li>

                        <!-- Last Page -->
                        @if (endPage < totalPages)
                        {
                            <li class="page-item">
                                <a class="page-link" asp-action="SeparationHistory" asp-route-pageNumber="@totalPages" asp-route-searchTerm="@currentFilter">&raquo;&raquo;</a>
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </div>
    </div>
</section>